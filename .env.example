# Backend
APP_NAME=Polymarket Copy Trader
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite:///./backend/data/app.db
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_DATA_URL=https://data-api.polymarket.com
COINGECKO_API_URL=https://api.coingecko.com/api/v3
ALLOWED_ORIGINS=http://localhost:5173
SESSION_SECRET=change-me
# PAPER = simulated copy trades, no real funds needed (default).
# LIVE  = real on-chain execution; requires funded wallet & MetaMask signing.
TRADING_MODE=PAPER
ENABLE_SIMULATED_EXECUTION=true
MONITOR_INTERVAL_SECONDS=5
LOW_BALANCE_THRESHOLD=25

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/trades
VITE_POLYGON_CHAIN_ID=137
VITE_USDC_CONTRACT=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174

